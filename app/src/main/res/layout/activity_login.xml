<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutSignIn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="358dp"
        android:layout_height="236dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ecogrid___copy" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewPanel"
        android:layout_width="413dp"
        android:layout_height="594dp"
        app:cardBackgroundColor="@color/md_theme_onBackground"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.666"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.83"
        app:shapeAppearanceOverlay="@style/ToRoundedCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/textView"
                android:layout_width="111dp"
                android:layout_height="18dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/sulphur_point_light"
                android:text="Email Address"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.194" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/sulphur_point_light"
                android:text="SIGN IN"
                android:textColor="#FDFDFD"
                android:textSize="40sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



            <TextView
                android:id="@+id/textView3"
                android:layout_width="111dp"
                android:layout_height="18dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/sulphur_point_light"
                android:text="Password"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.466" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="183dp"
                android:layout_height="18dp"
                android:layout_marginStart="132dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/sulphur_point_light"
                android:text="Forgotten Password !"
                android:textAlignment="viewEnd"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.709" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_address"
                android:layout_width="289dp"
                android:layout_height="54dp"
                android:layout_marginTop="64dp"
                android:background="@drawable/custome_input_boarder"
                android:drawableEnd="@drawable/mail_24dp_e3e3e3_fill0_wght400_grad0_opsz24___copy"
                android:outlineProvider="background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:textCursorDrawable="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.47"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                app:layout_constraintVertical_bias="0.0" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="289dp"
                android:layout_height="54dp"
                android:layout_marginTop="64dp"
                android:background="@drawable/custome_input_boarder"
                android:drawableEnd="@drawable/visibility_24dp_e3e3e3_fill0_wght400_grad0_opsz24___copy"
                android:outlineProvider="background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:textCursorDrawable="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.509"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                app:layout_constraintVertical_bias="0.416" />

            <Button
                android:id="@+id/button"
                android:layout_width="278dp"
                android:layout_height="59dp"
                android:text="@string/activity_login"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="24dp"
                app:backgroundTint="@color/design_default_color_on_primary"
                app:cornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                app:layout_constraintVertical_bias="0.897" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="286dp"
                android:layout_height="19dp"
                android:fontFamily="@font/sulphur_point_light"
                android:text="Doesn’t have an account ? Sign Up"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.574"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                app:layout_constraintVertical_bias="0.994" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>